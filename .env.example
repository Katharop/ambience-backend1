# ─────────────────────────────────────────────────────────────────────────────
# AMBIENCE Backend — Environment Variables Template
#
# ⚠️  NEVER commit the real .env file to Git.
#     Copy this file to .env and fill in your actual credentials.
#
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=5000
SERVER_URL=https://your-backend-domain.onrender.com
TRUST_PROXY=1

# ═══════════════════════════════════════════════════════════════════════════════
# CORS & Frontend
# ═══════════════════════════════════════════════════════════════════════════════
# Comma-separated list of allowed frontend origins (strict whitelist)
ALLOWED_ORIGINS=https://your-custom-domain.com,https://your-app.vercel.app
FRONTEND_URL=https://your-custom-domain.com

# ═══════════════════════════════════════════════════════════════════════════════
# MongoDB Atlas — Cloud Database
# ═══════════════════════════════════════════════════════════════════════════════
# FORMAT: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database_name>
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/ambience_db?retryWrites=true&w=majority

# ═══════════════════════════════════════════════════════════════════════════════
# JWT Secrets — Authentication Tokens
# ═══════════════════════════════════════════════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_64_BYTE_HEX_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_ANOTHER_64_BYTE_HEX_SECRET_HERE

# Session security — used for additional token entropy
SESSION_SECRET=GENERATE_A_RANDOM_STRING_HERE

# ═══════════════════════════════════════════════════════════════════════════════
# Razorpay Payment Gateway
# ═══════════════════════════════════════════════════════════════════════════════
# Get from: https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_, Live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Webhook secret — set in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ═══════════════════════════════════════════════════════════════════════════════
# Gmail REST API — Email Delivery (OTP, Order Receipts, Notifications)
# ═══════════════════════════════════════════════════════════════════════════════
# WHY GMAIL REST API INSTEAD OF SMTP?
#   Cloud providers (Render free tier, etc.) block outbound SMTP ports (465, 587).
#   The Gmail REST API operates over HTTPS (port 443) which is never blocked and
#   requires no custom domain.
#
# SETUP INSTRUCTIONS (One-time, 5 minutes):
#   1. Enable Gmail API in Google Cloud Console:
#      https://console.cloud.google.com/apis/library/gmail.googleapis.com
#   2. Create OAuth 2.0 Credentials (Web Application):
#      - Authorized redirect URI: https://developers.google.com/oauthplayground
#   3. Authorize via Google OAuth Playground:
#      - https://developers.google.com/oauthplayground
#      - Click ⚙️ (gear icon) → Check "Use your own OAuth credentials"
#      - Enter GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#      - In Step 1, select Gmail API v1 → https://www.googleapis.com/auth/gmail.send
#      - Click "Authorize APIs" & sign in with your GMAIL_USER address
#      - In Step 2, click "Exchange authorization code for tokens"
#      - Copy "Refresh token" and paste below as GMAIL_REFRESH_TOKEN
#
# DEV MODE: Leave as placeholders — OTPs will be safely logged to terminal console.
GMAIL_USER=your-email@gmail.com
GMAIL_REFRESH_TOKEN=YOUR_GMAIL_REFRESH_TOKEN
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ═══════════════════════════════════════════════════════════════════════════════
# Twitter/X OAuth 2.0 (Optional)
# ═══════════════════════════════════════════════════════════════════════════════
TWITTER_CLIENT_ID=YOUR_TWITTER_CLIENT_ID_HERE
TWITTER_CLIENT_SECRET=YOUR_TWITTER_CLIENT_SECRET_HERE
TWITTER_REDIRECT_URI=https://your-custom-domain.com/auth/twitter/callback

# ═══════════════════════════════════════════════════════════════════════════════
# Twilio SMS (Optional — for SMS OTP delivery)
# ═══════════════════════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════════════════════════════════
# AI Services (Optional — falls back to local NLP if not configured)
# ═══════════════════════════════════════════════════════════════════════════════
# Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud (Llama 3.3): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Resend Email API (alternative to Gmail SMTP)
RESEND_API_KEY=your_resend_api_key_here
