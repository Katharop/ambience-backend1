# ─────────────────────────────────────────────────────────────────────────────
# AMBIENCE Backend — Environment Variables
# Copy this file to .env and fill in your values
#
# ⚠️  NEVER commit .env to Git — it is listed in .gitignore by default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
SERVER_URL=http://localhost:5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ambience_db

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-byte-hex-secret-here
JWT_REFRESH_SECRET=generate-a-different-64-byte-hex-secret-here

# ── Razorpay Payment Gateway ────────────────────────────────────────────────
# Test keys:  https://dashboard.razorpay.com/app/keys (Test Mode)
# Live keys:  https://dashboard.razorpay.com/app/keys (Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── CORS (comma-separated origins) ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://ambienced.netlify.app,https://ambience-fronten.vercel.app

# ── Proxy Trust (set to 1 behind Render/Cloudflare/Nginx) ───────────────────
TRUST_PROXY=1

# ── Gmail SMTP (for Nodemailer email delivery) ──────────────────────────────
# DEV MODE: Keep as placeholder values (server will log OTPs to console)
# PROD MODE: Replace with your real Gmail credentials
# How to get App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials) ────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Twitter/X OAuth 2.0 (https://developer.twitter.com/en/portal/dashboard) ─
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:3000/auth/twitter/callback
