// ─────────────────────────────────────────────────────────────────────────────
// sessionStore.js
//
// AMBIENCE — In-Memory Session Management
//
// Manages authenticated user sessions using cryptographically secure tokens.
// Sessions are stored in memory (Map) — they persist as long as the server runs.
//
// Features:
//   • Crypto-random 64-character hex tokens
//   • Configurable TTL (default: 7 days)
//   • Automatic cleanup of expired sessions every hour
//   • No external dependencies
// ─────────────────────────────────────────────────────────────────────────────

const crypto = require("crypto");

// ── Configuration ───────────────────────────────────────────────────────────
const SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 days
const CLEANUP_INTERVAL_MS = 60 * 60 * 1000;      // 1 hour

// ── Session storage (Map: token → session data) ─────────────────────────────
const sessions = new Map();

// ── OTP storage (Map: email → { otp, type, expiresAt, attempts }) ───────────
const otpStore = new Map();
const OTP_TTL_MS = 10 * 60 * 1000; // 10 minutes
const MAX_OTP_ATTEMPTS = 5;

// ─────────────────────────────────────────────────────────────────────────────
// Session Management
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Create a new session for a user.
 *
 * @param {object} user — User data to associate with session (should NOT include password)
 * @returns {{ token: string, expiresAt: string }}
 */
const createSession = (user) => {
  const token = crypto.randomBytes(32).toString("hex"); // 64-char hex token
  const expiresAt = new Date(Date.now() + SESSION_TTL_MS);

  sessions.set(token, {
    userId: user.id,
    email: user.email,
    displayName: user.displayName,
    initial: user.email.charAt(0).toUpperCase(),
    createdAt: new Date().toISOString(),
    expiresAt: expiresAt.toISOString(),
  });

  console.log(`[SessionStore] ✅ Created session for: ${user.email} (active: ${sessions.size})`);

  return {
    token,
    expiresAt: expiresAt.toISOString(),
  };
};

/**
 * Validate a session token.
 *
 * @param {string} token — Session token to validate
 * @returns {object|null} — Session data if valid, null if invalid/expired
 */
const validateSession = (token) => {
  if (!token || typeof token !== "string") return null;

  const session = sessions.get(token);
  if (!session) return null;

  // Check expiry
  if (new Date(session.expiresAt) < new Date()) {
    sessions.delete(token);
    console.log(`[SessionStore] ⏰ Session expired for: ${session.email}`);
    return null;
  }

  return {
    userId: session.userId,
    email: session.email,
    displayName: session.displayName,
    initial: session.initial,
  };
};

/**
 * Destroy a session (logout).
 *
 * @param {string} token — Session token to destroy
 * @returns {{ success: boolean }}
 */
const destroySession = (token) => {
  if (!token) return { success: false };

  const session = sessions.get(token);
  if (session) {
    console.log(`[SessionStore] 🚪 Destroyed session for: ${session.email}`);
    sessions.delete(token);
    return { success: true };
  }

  return { success: false };
};

/**
 * Destroy all sessions for a specific user (e.g., after password reset).
 *
 * @param {string} userId — User ID
 */
const destroyAllUserSessions = (userId) => {
  let count = 0;
  for (const [token, session] of sessions.entries()) {
    if (session.userId === userId) {
      sessions.delete(token);
      count++;
    }
  }
  if (count > 0) {
    console.log(`[SessionStore] 🚪 Destroyed ${count} sessions for user: ${userId}`);
  }
};

// ─────────────────────────────────────────────────────────────────────────────
// OTP Management (stored server-side only — never sent to frontend)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Store an OTP for an email address.
 *
 * @param {string} email — Normalized email
 * @param {string} otp   — 6-digit OTP code
 * @param {string} type  — "register" | "reset" | "login"
 * @returns {void}
 */
const storeOTP = (email, otp, type = "register") => {
  const normalizedEmail = email.trim().toLowerCase();
  otpStore.set(normalizedEmail, {
    otp,
    type,
    attempts: 0,
    createdAt: new Date().toISOString(),
    expiresAt: new Date(Date.now() + OTP_TTL_MS).toISOString(),
  });

  console.log(`[SessionStore] 📌 OTP stored for: ${normalizedEmail} (type: ${type})`);
};

/**
 * Verify an OTP for an email address.
 *
 * @param {string} email   — Normalized email
 * @param {string} otpCode — OTP code to verify
 * @param {string} type    — Expected OTP type ("register" | "reset")
 * @returns {{ valid: boolean, error?: string }}
 */
const verifyOTP = (email, otpCode, type) => {
  const normalizedEmail = email.trim().toLowerCase();
  const stored = otpStore.get(normalizedEmail);

  if (!stored) {
    return { valid: false, error: "No verification code found. Please request a new one." };
  }

  // Check type matches
  if (stored.type !== type) {
    return { valid: false, error: "Invalid verification context. Please request a new code." };
  }

  // Check expiry
  if (new Date(stored.expiresAt) < new Date()) {
    otpStore.delete(normalizedEmail);
    return { valid: false, error: "Verification code has expired. Please request a new one." };
  }

  // Check max attempts
  if (stored.attempts >= MAX_OTP_ATTEMPTS) {
    otpStore.delete(normalizedEmail);
    return { valid: false, error: "Too many failed attempts. Please request a new verification code." };
  }

  // Compare OTP
  if (stored.otp !== otpCode) {
    stored.attempts++;
    const remaining = MAX_OTP_ATTEMPTS - stored.attempts;
    return {
      valid: false,
      error: `Incorrect verification code. ${remaining} attempt${remaining !== 1 ? "s" : ""} remaining.`,
    };
  }

  // Success — remove OTP
  otpStore.delete(normalizedEmail);
  console.log(`[SessionStore] ✅ OTP verified for: ${normalizedEmail}`);
  return { valid: true };
};

/**
 * Clear OTP for an email (e.g., on resend).
 *
 * @param {string} email — Normalized email
 */
const clearOTP = (email) => {
  const normalizedEmail = email.trim().toLowerCase();
  otpStore.delete(normalizedEmail);
};

// ─────────────────────────────────────────────────────────────────────────────
// Account Lockout Tracking
//
// Prevents brute-force password attacks by locking accounts after repeated
// failed login attempts. 5 failures within a window → 15-minute lockout.
// ─────────────────────────────────────────────────────────────────────────────

// ── Login attempt storage (Map: email → { count, lockedUntil }) ─────────────
const loginAttempts = new Map();
const MAX_LOGIN_ATTEMPTS = 5;
const LOCKOUT_DURATION_MS = 15 * 60 * 1000; // 15 minutes

/**
 * Record a failed login attempt for an email.
 * If attempt count reaches MAX_LOGIN_ATTEMPTS, lock the account for 15 minutes.
 *
 * @param {string} email — Normalized email address
 * @returns {{ locked: boolean, remainingAttempts: number }}
 */
const recordFailedLogin = (email) => {
  const normalizedEmail = email.trim().toLowerCase();
  const existing = loginAttempts.get(normalizedEmail) || { count: 0, lockedUntil: null };

  // If currently locked but lock has expired, reset
  if (existing.lockedUntil && new Date(existing.lockedUntil) < new Date()) {
    existing.count = 0;
    existing.lockedUntil = null;
  }

  existing.count++;

  if (existing.count >= MAX_LOGIN_ATTEMPTS) {
    existing.lockedUntil = new Date(Date.now() + LOCKOUT_DURATION_MS).toISOString();
    loginAttempts.set(normalizedEmail, existing);
    console.log(`[SessionStore] 🔒 Account locked for: ${normalizedEmail} (${MAX_LOGIN_ATTEMPTS} failed attempts)`);
    return { locked: true, remainingAttempts: 0 };
  }

  loginAttempts.set(normalizedEmail, existing);
  const remainingAttempts = MAX_LOGIN_ATTEMPTS - existing.count;
  console.log(`[SessionStore] ⚠️  Failed login for: ${normalizedEmail} (${existing.count}/${MAX_LOGIN_ATTEMPTS} attempts)`);
  return { locked: false, remainingAttempts };
};

/**
 * Check if an account is currently locked out.
 *
 * @param {string} email — Normalized email address
 * @returns {{ locked: boolean, remainingSeconds: number }}
 */
const isAccountLocked = (email) => {
  const normalizedEmail = email.trim().toLowerCase();
  const record = loginAttempts.get(normalizedEmail);

  if (!record || !record.lockedUntil) {
    return { locked: false, remainingSeconds: 0 };
  }

  const now = Date.now();
  const lockedUntil = new Date(record.lockedUntil).getTime();

  if (lockedUntil > now) {
    const remainingSeconds = Math.ceil((lockedUntil - now) / 1000);
    return { locked: true, remainingSeconds };
  }

  // Lock expired — clear it
  loginAttempts.delete(normalizedEmail);
  return { locked: false, remainingSeconds: 0 };
};

/**
 * Clear all failed login attempts for an email (called on successful login).
 *
 * @param {string} email — Normalized email address
 */
const clearLoginAttempts = (email) => {
  const normalizedEmail = email.trim().toLowerCase();
  if (loginAttempts.has(normalizedEmail)) {
    loginAttempts.delete(normalizedEmail);
    console.log(`[SessionStore] ✅ Cleared login attempts for: ${normalizedEmail}`);
  }
};

// ─────────────────────────────────────────────────────────────────────────────
// Automatic Cleanup — Remove expired sessions, OTPs, and lockouts every hour
// ─────────────────────────────────────────────────────────────────────────────
const cleanup = () => {
  const now = new Date();
  let sessionsCleaned = 0;
  let otpsCleaned = 0;
  let lockoutsCleaned = 0;

  for (const [token, session] of sessions.entries()) {
    if (new Date(session.expiresAt) < now) {
      sessions.delete(token);
      sessionsCleaned++;
    }
  }

  for (const [email, otp] of otpStore.entries()) {
    if (new Date(otp.expiresAt) < now) {
      otpStore.delete(email);
      otpsCleaned++;
    }
  }

  // Clean expired lockouts
  for (const [email, record] of loginAttempts.entries()) {
    if (record.lockedUntil && new Date(record.lockedUntil) < now) {
      loginAttempts.delete(email);
      lockoutsCleaned++;
    }
  }

  if (sessionsCleaned > 0 || otpsCleaned > 0 || lockoutsCleaned > 0) {
    console.log(`[SessionStore] 🧹 Cleanup: removed ${sessionsCleaned} expired sessions, ${otpsCleaned} expired OTPs, ${lockoutsCleaned} expired lockouts`);
  }
};

// Run cleanup periodically
setInterval(cleanup, CLEANUP_INTERVAL_MS);

module.exports = {
  // Sessions
  createSession,
  validateSession,
  destroySession,
  destroyAllUserSessions,

  // OTPs
  storeOTP,
  verifyOTP,
  clearOTP,

  // Account Lockout
  recordFailedLogin,
  isAccountLocked,
  clearLoginAttempts,
};
